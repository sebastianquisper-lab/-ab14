3.	name: Build and Deploy .NET Application
4.	
5.	on:
6.	  push:
7.	    branches:
8.	      - main # Automáticamente se ejecuta cuando se suben cambios a la rama principal
9.	
10.	jobs:
11.	  build:
12.	    runs-on: ubuntu-latest
13.	    
14.	    steps:
15.	    - name: Check out code
16.	      uses: actions/checkout@v2
17.	
18.	    - name: Set up .NET
19.	      uses: actions/setup-dotnet@v1
20.	      with:
21.	        dotnet-version: '8.0'
22.	
23.	    - name: Restore dependencies
24.	      run: dotnet restore
25.	
26.	    - name: Build application
27.	      run: dotnet build --configuration Release
28.	
29.	    - name: Publish application
30.	      run: dotnet publish --configuration Release --output ./published
31.	
32.	    - name: Deploy to server (ejemplo de despliegue)
33.	      run: |
34.	        scp -r ./published username@server:/path/to/deploy
